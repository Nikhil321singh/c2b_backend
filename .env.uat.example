# Runtime
# Render dashboard: Node Version = 20 (repo has no .node-version/engines).
NODE_ENV=production
# On Render this must NOT be "lambda" — that skips server.listen() in server.js.
ENVIRONMENT=uat
# Local/dev only. On Render, DO NOT set PORT — Render injects it automatically.
PORT=7002

# Database and existing application secrets
# Required on Render: full MongoDB Atlas connection string.
MONGO_URI=
# Required on Render: strong random secret. The name spelling is intentional.
JWT_SECERET=
PAYOUT_VPA_HASH_KEY=
PAYOUT_FRAUD_HASH_KEY=

# HSBC UPI UAT
HSBC_UPI_MERCHANT_ID=
HSBC_UPI_MERCHANT_KEY=
HSBC_UPI_MERCHANT_VPA=
HSBC_UPI_BASE_URL=https://upiapi-uat.hsbc.co.in
HSBC_UPI_VALIDATE_PATH=/upi/api/v2/meValidateVPA
HSBC_UPI_PAY_PATH=/upi/api/v2/mePayRefundApi
HSBC_UPI_STATUS_PATHS=/upi/v2/mePayTransQuery,/upi/api/v2/mePayTransQuery
HSBC_UPI_TIMEOUT_MS=30000
HSBC_UPI_ENCRYPTION_MODE=UPIKIT
HSBC_UPI_KEY_ENCODING=hex
HSBC_UPI_OUTPUT_ENCODING=hex
HSBC_UPI_MOCK_MODE=false

# HSBC Treasury Payment Initiation (IMPS bank transfer). Sandbox mock works with
# the placeholder credentials; real UAT needs the PIC profile id, client id/
# secret, PGP keys, and the GREST debit account from the HSBC integration team.
HSBC_PAYMENT_BASE_URL=https://sandbox.corporate-api.hsbc.com/mock/v1
HSBC_PAYMENT_PROFILE_ID=
HSBC_PAYMENT_CLIENT_ID=
HSBC_PAYMENT_CLIENT_SECRET=
HSBC_PAYMENT_SERVICE_PROVIDER_ID=
HSBC_PAYMENT_DEBIT_ACCOUNT=
HSBC_PAYMENT_AUTH_TOKEN=1234
HSBC_PAYMENT_COUNTRY_CODE=IN
HSBC_PAYMENT_TIMEOUT_MS=30000
# Local/dev only — returns a canned success without calling HSBC.
HSBC_PAYMENT_MOCK_MODE=false
# Webhook (Payment Status Notification) — validate HSBC's callback headers.
HSBC_PAYMENT_WEBHOOK_CLIENT_ID=
HSBC_PAYMENT_WEBHOOK_SECRET=
# NEFT (pain.001 credit transfer). Debtor + clearing codes; confirm codes with HSBC.
HSBC_PAYMENT_DEBIT_NAME=GREST
HSBC_PAYMENT_DEBIT_BIC=
HSBC_NEFT_SERVICE_LEVEL=NURG
HSBC_NEFT_LOCAL_INSTRUMENT=NEFT
# PGP for Payment Initiation. 'none' = plain XML (sandbox); 'pgp' = encrypt+sign
# the payload into paymentBase64 (real UAT/prod). Key files live in git-ignored
# hsbc-keys/. Passphrase ships with the HSBC key archive.
HSBC_PAYMENT_PAYLOAD_ENCRYPTION=none
HSBC_PAYMENT_PGP_CLIENT_PRIVATE_KEY_PATH=./hsbc-keys/client-private.key
HSBC_PAYMENT_PGP_HSBC_PUBLIC_KEY_PATH=./hsbc-keys/hsbc-public.key
HSBC_PAYMENT_PGP_PASSPHRASE=1password

# Customer link
PAYOUT_CUSTOMER_APP_URL=https://uat.example.com/payout

# Ceiling applied to a store that has no ceiling of its own. Set to 0 to leave
# such stores uncapped.
DEFAULT_STORE_PAYOUT_CEILING=50000

# UAT notification delivery. Replace with MSG91 settings when SMS templates
# are approved.
PAYOUT_NOTIFICATION_MODE=EMAIL
PAYOUT_LINK_NOTIFICATION_MODE=SMS
PAYOUT_SUCCESS_NOTIFICATION_MODE=EMAIL
PAYOUT_NOTIFICATION_EMAIL=qa@example.com
# SMS provider (MSG91). Auth key is shared with the existing OTP SMS flow.
MSG91_AUTHKEY=
# OTP SMS DLT flow/template id (existing login OTP).
MSG91_FLOW_TEMPLATE_ID=
# DLT-approved payout templates. Link is approved; success is pending approval.
MSG91_PAYOUT_LINK_TEMPLATE_ID=
MSG91_PAYOUT_SUCCESS_TEMPLATE_ID=
MSG91_PAYOUT_SHORT_URL_ENABLED=true

# Notification channel per event: EMAIL or SMS. Link defaults to SMS, success to
# EMAIL until the success SMS template is approved.
PAYOUT_NOTIFICATION_MODE=EMAIL
PAYOUT_LINK_NOTIFICATION_MODE=SMS
PAYOUT_SUCCESS_NOTIFICATION_MODE=EMAIL
# Fallback recipient when a lead has no valid customer email.
PAYOUT_NOTIFICATION_EMAIL=

# Background status/receipt reconciliation. Render runs this cron on every
# instance, so keep instance count = 1 or set this to false.
HSBC_PAYOUT_RECONCILIATION_ENABLED=true

# Must remain false outside local development.
PAYOUT_FORCE_HSBC_IN_DEVELOPMENT=false

# Existing email/PDF/S3 settings are also required for receipt delivery.
MAIL=
MAIL_PASS=
PDF_URI=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_FOLDER=receipts
